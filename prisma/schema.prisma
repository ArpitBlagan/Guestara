model Category{
 id String @id @default(uuid())
  name String
image String
description String
tax_applicability Boolean
tax Int?
taxType String?
  subCategories Subcategory[]

}

model Item{
  id String @id @default(uuid())
  subCat String
  subCategory Subcategory @relation(fields: [subCat],references: [id])
  name String
image String
tax_applicability Boolean
tax Int?
}

model Subcategory{
id String @id @default(uuid())
catId String
  category Category @relation( fields: [catId],references: [id])
  name String
image String
items Item[]
tax_applicability Boolean
tax Int?
base_amount Int
discount Int
total_amount Int
}